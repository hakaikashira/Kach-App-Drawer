[Variables]

; Number of applications visible at the same time.
; This is the user-facing setting.
VisibleApps=10

; Maximum supported simultaneous slots.
; The skin ships with 64 physical icon meters.
; VisibleApps can be any value from 1 to MaxApps.
MaxApps=64

IconSize=30
IconHoverSize=44
IconGap=14

DrawerWidth=72
CornerRadius=18

NormalAlpha=105
HoverAlpha=255

ShowLabels=0
LabelGap=8

; Automatic bonus for applications
; that have a Windows desktop shortcut.
DesktopBonus=100
